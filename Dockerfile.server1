FROM ubuntu:24.04

RUN sed -i 's|http://archive.ubuntu.com|http://mirrors.edge.kernel.org|' /etc/apt/sources.list.d/ubuntu.sources
RUN apt-get update && apt-get install -y python3 python3-pip && rm -rf /var/lib/apt/lists/*
RUN pip3 install --break-system-packages flask mysql-connector-python pytest requests

COPY server1.py rest_test.py /

CMD ["python3", "-u", "server1.py"]
